# Database
POSTGRES_DB=mt_optimizer_prod
POSTGRES_USER=mt_optimizer
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_HERE

# Application
SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
ENVIRONMENT=production
LOG_LEVEL=INFO

# Domain
DOMAIN=yourdomain.com

# MT5 Runner (optional - for demo account testing)
MT5_TERMINAL_PATH=/opt/mt5/terminal64.exe
MT5_LOGIN=your_demo_account_number
MT5_PASSWORD=your_demo_password
MT5_SERVER=broker_server_name

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD_HERE

# Celery
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=7200
